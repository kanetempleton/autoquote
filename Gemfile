source "https://rubygems.org"

# Application
gem "sinatra"
gem "rack"
gem "rackup"
gem "puma"                 # better server than the default Webrick

# Testing core
gem "rspec"
gem "cucumber"
gem "capybara"
gem "capybara-playwright-driver"   # this brings in playwright-ruby-client

# Helpful supporting gems
gem "json"
gem "faraday"              # clean HTTP client for API tests
gem "pry"                  # debugging (optional but useful)

group :development, :test do
  gem "dotenv"             # for environment config later
end


